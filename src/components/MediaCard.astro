---
import type { Site } from "../lib/sites";
import { path } from "../lib/sites";
import SnsList from "./SnsList.astro";
type Props = { site: Site; compact?: boolean };
const { site, compact = false } = Astro.props;
---
<article class="card" style={`--c:${site.colors.primary};--c2:${site.colors.secondary}`}>
  <div class="band"></div>
  <div class="body">
    <span class="tag">{site.role}</span>
    <h2>{site.name}</h2>
    <p class="desc">{compact ? site.description : site.long}</p>
    <a class="go" href={site.url} target="_blank" rel="noopener">
      <span>サイトを見る <small>{site.host}</small></span>
      <span aria-hidden="true">→</span>
    </a>
    <a class="chip" href={path(`${site.id}/`)}>このメディアの案内</a>
    <SnsList accounts={site.sns} color={site.colors.primary} />
  </div>
</article>
