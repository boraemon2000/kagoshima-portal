---
import { formatDate, siteById, type LatestPost } from "../lib/sites";
type Props = { posts: LatestPost[]; showSite?: boolean };
const { posts, showSite = true } = Astro.props;
---
{posts.length === 0 ? (
  <p class="note">まだ新着を取り込めていません。各メディアのサイトで最新を見てください。</p>
) : (
  <div class="post-list">
    {posts.map((p) => {
      const site = siteById(p.siteId);
      return (
        <a class="post" href={p.url} target="_blank" rel="noopener" style={`--c:${site.colors.primary}`}>
          <div class="post-meta">
            {showSite && <span>{site.name}</span>}
            <time datetime={p.date}>{formatDate(p.date)}</time>
          </div>
          <h3>{p.title}</h3>
          {p.excerpt && <p>{p.excerpt}</p>}
        </a>
      );
    })}
  </div>
)}
