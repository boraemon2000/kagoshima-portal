---
import { asset, portal, sites, nav, path } from "../lib/sites";
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={path("/")}>
      <span class="mark" aria-hidden="true">
        {sites.map((s) => <i style={`background:${s.colors.primary}`}></i>)}
      </span>
      <strong>
        <span class="brand-full">{portal.name}</span>
        <span class="brand-short">カゴシマ</span>
      </strong>
    </a>
    <nav id="site-nav" class="nav" aria-label="主要">
      <details>
        <summary>メディア</summary>
        <div class="sub">
          {sites.map((s) => (
            <a href={path(`${s.id}/`)}>
              <img class="nav-logo" src={asset(s.mark ?? s.logo)} alt="" width="28" height="28" />
              {s.name}
            </a>
          ))}
        </div>
      </details>
      {nav.map((item) => (
        <a href={path(item.href)}>{item.label}</a>
      ))}
      <a href={path("about/")}>このポータルについて</a>
    </nav>
    <div class="tools">
      <button class="theme-btn" type="button" data-theme-toggle aria-label="ライトとダークを切り替え">色</button>
      <button class="menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav">開く</button>
    </div>
  </div>
</header>
