---
import Base from "../layouts/Base.astro";
import MediaCard from "../components/MediaCard.astro";
import PostList from "../components/PostList.astro";
import { portal, sites, guides, path, postsFor, latest } from "../lib/sites";

const posts = postsFor(undefined, 8);
---
<Base title={portal.name} description={portal.description} path="">
  <header class="mast">
    <div class="wrap mast-inner">
      <div>
        <span class="kicker">{portal.nameEn}  {portal.year}</span>
        <h1>
          <span class="word">カゴシマ</span>
          <span class="word-sub">メディアポータル</span>
        </h1>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#media">サイトを開く</a>
          <a class="btn btn-ghost" href="#sns">SNSをフォロー</a>
          <a class="btn btn-ghost" href={path("guide/")}>どれを見ればいいか</a>
          <a class="btn btn-ghost" href={path("for-business/")}>発表・相談</a>
        </div>
      </div>
      <div class="mast-flag" aria-hidden="true">
        {sites.map((s) => <i style={`background:${s.colors.primary}`}></i>)}
      </div>
    </div>
  </header>

  <section class="posters" id="media" aria-label="4つのメディア">
    <h2 class="vh" id="sns">SNSをフォロー</h2>
    {sites.map((s, i) => <MediaCard site={s} index={i + 1} />)}
  </section>

  <section class="section wrap" id="guide">
    <h2>どれを見ればいい</h2>
    <div class="guides tile-guides">
      {guides.slice(0, 6).map((g) => {
        const site = sites.find((s) => s.id === g.siteId)!;
        return (
          <a class="guide-tile" href={path("guide/") + `#${g.id}`} style={`--c:${site.colors.primary}`}>
            <span class="swatch" aria-hidden="true"></span>
            <h3>{g.title}</h3>
          </a>
        );
      })}
    </div>
    <p class="more-link"><a href={path("guide/")}>目的別ナビを全部見る</a></p>
  </section>

  <section class="section wrap" id="latest">
    <h2>新着</h2>
    {latest.updatedAt && (
      <p class="sec-lead quiet">{latest.updatedAt.replace("T", " ").replace("Z", " UTC")}</p>
    )}
    <PostList posts={posts} compact />
    <p class="more-link"><a href={path("latest/")}>新着フィードをすべて見る</a></p>
  </section>

  <p class="wrap about-one">
    {portal.description}
    <a href={path("about/")}>運営方針</a>
  </p>
</Base>
